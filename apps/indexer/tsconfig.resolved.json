{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "resolvePackageJsonExports": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "target": "es2023",
        "sourceMap": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "incremental": true,
        "skipLibCheck": true,
        "strictNullChecks": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitAny": true,
        "strictBindCallApply": true,
        "noFallthroughCasesInSwitch": true,
        "moduleDetection": "force",
        "resolvePackageJsonImports": true,
        "resolveJsonModule": true,
        "preserveConstEnums": true,
        "useDefineForClassFields": true
    },
    "files": [
        "./src/app.module.ts",
        "./src/main.ts",
        "./src/config/env.validation.ts",
        "./src/database/database.module.ts",
        "./src/database/prisma.service.ts",
        "./src/health/health.controller.ts",
        "./src/health/health.module.ts",
        "./src/indexer/abi.loader.ts",
        "./src/indexer/blockchain-source.service.ts",
        "./src/indexer/event-processor.service.ts",
        "./src/indexer/indexer-runner.service.ts",
        "./src/indexer/indexer.module.ts",
        "./src/indexer/indexer.types.ts",
        "./src/indexer/redis-lock.service.ts",
        "./src/indexer/structured-logger.service.ts",
        "./src/redis/redis.constants.ts",
        "./src/redis/redis.module.ts",
        "./src/redis/redis.service.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.spec.ts"
    ]
}
