# Arc Testnet (public, non-secret values)
NODE_ENV=testnet
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
RPC_URL=https://rpc.testnet.arc.network
WS_RPC_URL=wss://rpc.testnet.arc.network
CHAIN_ID=5042002
BLOCK_EXPLORER_URL=https://testnet.arcscan.app

# Never commit real keys. Use test-only wallets.
PRIVATE_KEY=
TEST_WALLET_PRIVATE_KEYS=

# Acceptance deployment parameters. Native values use 18 decimals (USDC gas).
FEE_BPS=100
BASE_PRICE=1000000000000
CURVE_SLOPE=1000000000000
GRADUATION_THRESHOLD=10000000000000000
ACCEPTANCE_MAX_TOTAL_NATIVE_WEI=50000000000000000
PUMP_FACTORY_ADDRESS=
INDEXER_START_BLOCK=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pumpnow_testnet
REDIS_URL=redis://localhost:6379
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
API_CACHE_TTL_SECONDS=5
API_STATS_CACHE_TTL_SECONDS=5

INDEXER_PORT=3002
INDEXER_MODE=live
INDEXER_CONFIRMATIONS=0
INDEXER_BLOCK_RANGE=1000
INDEXER_POLL_INTERVAL_MS=1000
INDEXER_MAX_RETRIES=8
INDEXER_LOCK_TTL_MS=30000

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_CHAIN_NAME=Arc Testnet
NEXT_PUBLIC_NATIVE_SYMBOL=USDC
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://testnet.arcscan.app
NEXT_PUBLIC_PUMP_FACTORY_ADDRESS=
